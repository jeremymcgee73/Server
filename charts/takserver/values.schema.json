      "additionalProperties": true
    },
    "exposure": {
      "type": "object",
      "properties": {
        "mode": {"type": "string", "enum": ["disabled", "service", "ingress", "gateway"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

    "images": {"type": "object", "additionalProperties": {"type": "object"}},
    "workloads": {"type": "object", "additionalProperties": {"type": "object"}},
    "database": {
      "type": "object",
      "properties": {
        "mode": {"type": "string", "enum": ["external", "embedded"]},
        "external": {"type": "object"},
        "auth": {"type": "object"},
        "embedded": {"type": "object"},
        "migration": {"type": "object"}
